@Component
script CombatWalletBridge extends Component
    @ExecSpace("ServerOnly")
    method void OnUpdate(number delta)
        -- Drains completed pickup rewards into server-owned wallet and inventory boundaries.
        self:DrainServerRewards()
    end

    @ExecSpace("ServerOnly")
    method void DrainServerRewards()
        -- Settles typed Common Coin rewards once while preserving item grants for inventory.
        local player = self.Entity.PlayerComponent
        if not isvalid(player) then return end
        local wallet = self.Entity:GetComponent("script.PlayerWalletComponent")
        if not isvalid(wallet) then
            wallet = self.Entity:AddComponent("PlayerWalletComponent")
        end
        if not isvalid(wallet) or wallet.Initialized ~= true then return end
        local rewards = _CombatRuntime:DrainPendingRewards(player.UserId)
        local inventory = self.Entity:GetComponent("script.EquipmentInventoryComponent")
        for _, reward in ipairs(rewards) do
            if reward.rewardType == "CURRENCY" and reward.rewardKey == "COMMON_COIN" then
                if isvalid(wallet) and wallet:SettleCombatReward(reward.quantity, reward.transactionId) then
                    log("[Combat] Wallet reward settled tx=" .. tostring(reward.transactionId)
                        .. " COMMON_COIN x" .. tostring(reward.quantity))
                end
            elseif reward.rewardType == "ITEM" and isvalid(inventory) then
                inventory:GrantItemByKey(reward.rewardKey, reward.quantity)
                log("[Combat] Inventory reward delivered tx=" .. tostring(reward.transactionId)
                    .. " " .. tostring(reward.rewardKey) .. " x" .. tostring(reward.quantity))
            else
                log_error("[Combat] Reward boundary rejected tx=" .. tostring(reward.transactionId)
                    .. " " .. tostring(reward.rewardType) .. ":" .. tostring(reward.rewardKey))
            end
        end
    end
end
